# macOS
.DS_Store

# 本地临时渲染与构建产物
.tmp-stage6-artifact/

# 依赖与缓存
node_modules/
__pycache__/
*.py[cod]
dist/
coverage/
playwright-report/
test-results/
apps/web/src/**/*.js
apps/web/vite.config.js
apps/web/vite.config.d.ts
apps/web/*.tsbuildinfo

# 运行期上传文件（目录结构保留）
**/var/uploads/*
!var/uploads/.gitkeep

# 本地环境与密钥
.env
.env.*
!.env.example

# 编辑器临时文件
*.swp
*.swo
*~
