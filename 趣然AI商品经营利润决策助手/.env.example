POSTGRES_PASSWORD=replace-with-long-random-password
BACKUP_ENCRYPTION_PASSWORD=replace-with-independent-backup-password
APP_IMAGE_TAG=local
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000

QURAN_APP_ENV=production
QURAN_DATABASE_URL=postgresql+psycopg://quran_app:replace-with-url-encoded-password@postgres:5432/quran
QURAN_PUBLIC_BASE_URL=https://profit.example.internal
QURAN_FRONTEND_BASE_URL=https://profit.example.internal
QURAN_COOKIE_SECURE=true
QURAN_DINGTALK_CLIENT_ID=replace-with-dingtalk-client-id
QURAN_DINGTALK_CLIENT_SECRET=replace-with-dingtalk-client-secret
QURAN_LITELLM_BASE_URL=https://litellm.example.internal/v1
QURAN_LITELLM_API_KEY=replace-with-deployment-secret
QURAN_LITELLM_MODEL=replace-with-approved-model-route
QURAN_UPLOAD_SPOOL_DIR=/var/lib/quran/uploads
